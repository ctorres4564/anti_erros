# ==============================================================================
# ANTI-ERROS | MÉTODO APRENDER - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# Supabase (Públicas no Client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase (Privada no Server - NUNCA EXPOR NO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Cloudflare Turnstile (site key pública; secret somente no servidor)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-here
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here
# Exclusivo para suítes automatizadas locais; NUNCA usar em produção.
# O código ignora esta flag quando NODE_ENV=production, mesmo se configurada incorretamente.
TURNSTILE_TEST_BYPASS=false

# Google Gemini (Privada no Server)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-3.7-flash

# Segredo do HMAC de hashing de IP anônimo (telemetria sem PII). Obrigatório em
# produção — gere um valor aleatório de alta entropia (ex: openssl rand -hex 32).
# Nunca reaproveite outro segredo (ex: SUPABASE_SERVICE_ROLE_KEY) para esta finalidade.
IP_SALT_SECRET=your-ip-hmac-salt-here

# Aplicação & Limites
NEXT_PUBLIC_APP_URL=http://localhost:3000
DAILY_ANALYSIS_QUOTA=5
IDEMPOTENCY_LOCK_TTL_SECONDS=120

# Versões Legais (LGPD)
LEGAL_TERMS_VERSION=v1.0.0
LEGAL_PRIVACY_VERSION=v1.0.0
MARKETING_POLICY_VERSION=v1.0.0
