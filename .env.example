# ==============================================================================
# ANTI-ERROS | MÉTODO APRENDER - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# Supabase (Públicas no Client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase (Privada no Server - NUNCA EXPOR NO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Google Gemini (Privada no Server)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.5-flash

# Aplicação & Limites
NEXT_PUBLIC_APP_URL=http://localhost:3000
DAILY_ANALYSIS_QUOTA=5
IDEMPOTENCY_LOCK_TTL_SECONDS=120

# Versões Legais (LGPD)
LEGAL_TERMS_VERSION=v1.0.0
LEGAL_PRIVACY_VERSION=v1.0.0
MARKETING_POLICY_VERSION=v1.0.0
